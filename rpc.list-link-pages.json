{
    "name": "listLinkPagesRpc",
    "label": "List Link Pages",
    "connection": "nimply-oauth",
    "communication": {
        "url": "/v1/link-pages",
        "method": "GET",
        "response": {
            "iterate": "{{body.data}}",
            "output": {
                "label": "{{ifempty(item.title, item.handle)}} (nimply.link/{{item.handle}})",
                "value": "{{item.id}}"
            }
        }
    }
}
