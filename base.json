{
    "baseUrl": "https://api.nimply.io",
    "headers": {
        "authorization": "Bearer {{connection.accessToken}}"
    },
    "response": {
        "error": {
            "message": "[{{statusCode}}] {{body.detail || body.title || body.message}}"
        }
    },
    "log": {
        "sanitize": ["request.headers.authorization"]
    }
}
