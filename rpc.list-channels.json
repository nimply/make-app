{
    "name": "listChannelsRpc",
    "label": "List Channels",
    "connection": "nimply-oauth",
    "communication": {
        "url": "/v1/channels",
        "method": "GET",
        "response": {
            "iterate": {
                "container": "{{body}}",
                "condition": "{{item.capabilities.publish != false}}"
            },
            "output": {
                "label": "{{item.name}} ({{item.type}})",
                "value": "{{item.id}}"
            }
        }
    }
}
